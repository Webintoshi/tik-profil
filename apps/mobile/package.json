{
  "name": "@tikprofil/mobile",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "export:web": "expo export --platform web",
    "proxy": "node ./scripts/dev-admin-api-proxy.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && node ./scripts/mobile-smoke-test.mjs && npm run test:browser:task5 && npm run test:browser:task6 && npm run test:browser:task7 && npm run test:browser:task8",
    "test:browser:task5": "node ./scripts/task5-browser-regression.mjs",
    "test:browser:task6": "node ./scripts/task6-browser-qr-regression.mjs",
    "test:browser:task7": "node ./scripts/task7-browser-regression.mjs",
    "test:browser:task8": "node ./scripts/task8-browser-regression.mjs",
    "test:browser:task8:update": "node ./scripts/task8-browser-regression.mjs --update-baselines",
    "test:unit": "node --test ./src/**/*.test.mts",
    "build:apk": "node ./scripts/build-android-apk.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/material-symbols": "0.4.38",
    "@expo/metro-runtime": "56.0.13",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "^2.3.1",
    "expo": "56.0.8",
    "expo-auth-session": "~56.0.15",
    "expo-blur": "^56.0.3",
    "expo-camera": "~56.0.8",
    "expo-font": "~56.0.5",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.10",
    "expo-image-picker": "^56.0.18",
    "expo-linear-gradient": "56.0.4",
    "expo-location": "~56.0.16",
    "expo-router": "56.2.8",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "3.0.5",
    "expo-web-browser": "~56.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.18.0",
    "react-native-svg": "15.15.4",
