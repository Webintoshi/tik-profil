# Environment Variables (Supabase)
# Copy this file to .env.local and fill in your Supabase credentials

# Supabase (server)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Supabase (client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PostgreSQL foundation (optional until used)
DATABASE_URL=
BUSINESS_DATA_PROVIDER=legacy_supabase
BUSINESS_DUAL_READ_COMPARE=0

# Security
SESSION_SECRET=

# Ordu petshop import providers (server-side only)
GOOGLE_MAPS_API_KEY=
BUSINESS_IMPORT_RECOVERY_FROM_EMAIL=

# Auth foundation
AUTH_PROVIDER=legacy
LOGTO_ENDPOINT=
LOGTO_APP_ID=
LOGTO_APP_SECRET=
LOGTO_COOKIE_SECRET=
LOGTO_BASE_URL=
LOGTO_MOBILE_API_AUDIENCE=
LOGTO_MANAGEMENT_APP_ID=
LOGTO_MANAGEMENT_APP_SECRET=
LOGTO_TEST_PROVISIONING_SECRET=

# Logto HTTP SMS connector -> Tik Profil -> Netgsm (server-side only)
LOGTO_SMS_WEBHOOK_SECRET=
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=
NETGSM_OTP_APPNAME=
NETGSM_OTP_ENDPOINT=https://api.netgsm.com.tr/sms/rest/v2/otp

# Expo mobile OIDC public client (never put a client secret in EXPO_PUBLIC_* values)
EXPO_PUBLIC_LOGTO_ENDPOINT=
# The app accepts the Logto base URL and normalizes it to the /oidc issuer used by expo-auth-session.
EXPO_PUBLIC_LOGTO_APP_ID=
# Must equal the Logto API resource identifier configured in LOGTO_MOBILE_API_AUDIENCE
EXPO_PUBLIC_LOGTO_API_AUDIENCE=
EXPO_PUBLIC_TIKPROFIL_API_URL=https://tikprofil.com
# Native redirect URI to allow on the Logto Native app: tikprofil://auth/callback
# Local Expo web redirect URI: http://localhost:8082/account
# Production web redirect URI must match the exact HTTPS origin and callback path emitted by Expo web.
# Add the web origin to Logto Allowed CORS origins. Enable Authorization Code + PKCE and Refresh Token grants.

# Analytics foundation
UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=

# App URLs (optional)
APP_URL=
NEXT_PUBLIC_APP_URL=

# Optional: Supabase schema apply helpers
SUPABASE_DB_PASSWORD=
SUPABASE_POOLER_HOST=
SUPABASE_POOLER_PORT=6543
SUPABASE_POOLER_USER=
SUPABASE_POOLER_DB=postgres

# Optional: legacy storage scan/migration helpers
LEGACY_STORAGE_DOMAINS=
LEGACY_STORAGE_REGEX=
